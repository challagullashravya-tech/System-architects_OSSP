#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int pid1, pid2, status;

    pid1 = fork();

    if (pid1 == 0)
    {
        printf("Child 1: PID = %d\n", getpid());
        sleep(2);
        printf("Child 1 completed\n");
        return 10;
    }

    pid2 = fork();

    if (pid2 == 0)
    {
        printf("Child 2: PID = %d\n", getpid());
        sleep(4);
        printf("Child 2 completed\n");
        return 20;
    }

    // Parent process
    printf("Parent: PID = %d\n", getpid());

    // wait() waits for any child
    int completed_pid = wait(&status);

    printf("wait(): Child %d completed\n", completed_pid);
    printf("Child exit status: %d\n", WEXITSTATUS(status));

    // waitpid() waits for a specific child
    waitpid(pid2, &status, 0);

    printf("waitpid(): Child %d completed\n", pid2);
    printf("Child exit status: %d\n", WEXITSTATUS(status));

    return 0;
}
